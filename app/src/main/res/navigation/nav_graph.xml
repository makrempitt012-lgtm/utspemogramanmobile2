<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/productListFragment">

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.example.uts_pemogramanmobile2.ui.product.ProductListFragment"
        android:label="Daftar Produk"
        tools:layout="@layout/fragment_product_list">
        <action
            android:id="@+id/action_productListFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.uts_pemogramanmobile2.ui.product.ProductDetailFragment"
        android:label="Detail Produk"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="product"
            app:argType="com.example.uts_pemogramanmobile2.model.Product" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.uts_pemogramanmobile2.ui.profile.ProfileFragment"
        android:label="Profil Developer"
        tools:layout="@layout/fragment_profile" />

</navigation>